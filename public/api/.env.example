# Copy to public/api/.env on the server. Never commit real keys.
# Every merchant has different mPurse keys, MID, VPA, payee name and site URL.
# Never copy another site's .env.
#
# Local: yarn php:api (XAMPP PHP on 127.0.0.1:8088), then keep yarn dev running.
# Next proxies /api/mpurse.php to that port in development only.

SITE_URL=https://prime-hive.com

# --- mPurse merchant ---
MPURSE_MID=
MPURSE_PASS_KEY=
MPURSE_AES_KEY=
MPURSE_CLIENT_ID=
MPURSE_CLIENT_SECRET=
# From the merchant's real UPI/QR, e.g. xxxxxxxxxx.mp@nsdlpbma
MPURSE_PAYEE_VPA=
MPURSE_PAYEE_NAME=TANIKSHA ENTERPRISES
MPURSE_MCC=8999
MPURSE_MERCHANT_TYPE=AGGREGATE
MPURSE_EXPIRY_MINUTES=10

# --- Order notifications ---
MAIL_TO=info@prime-hive.com
MAIL_FROM=info@prime-hive.com
MAIL_FROM_NAME=TANIKSHA ENTERPRISES
ORDER_NOTIFY_EMAIL=info@prime-hive.com

# --- SMTP: the site mailbox, never the customer's address ---
# Read by both api/mpurse.php and submit.php. Use smtps on 465, or tls on 587.
# Incoming ports, for mail clients only: IMAP 993 / POP3 995 on the same host.
SMTP_HOST=mail.your-domain.com
SMTP_USER=info@your-domain.com
SMTP_PASS=
SMTP_PORT=465
SMTP_SECURE=smtps
