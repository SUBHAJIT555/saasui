# Secrets and the order store live beside mpurse.php, so they must never be
# fetchable. Repeated here rather than relying on the parent .htaccess, because
# this folder is sometimes uploaded on its own.
<FilesMatch "^(\.env.*|mpurse\.env|.*\.json|.*\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
